---
const { date = "1° de octubre 2025", items = [] } = Astro.props;

interface UpdateItem {
  label: string;
  value: string;
}

interface Props {
  date?: string;
  items?: UpdateItem[];
}
---

<section role="region" aria-label="Actualización de alquileres" class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm dark:border-neutral-700 dark:bg-neutral-900 md:p-8 xl:p-10 2xl:p-12">
    <!-- Header -->
    <div class="flex items-center gap-4 mb-6 xl:mb-8 2xl:mb-10">
      <div class="flex h-12 w-12 xl:h-16 xl:w-16 2xl:h-20 2xl:w-20 items-center justify-center rounded-full bg-yellow-100 dark:bg-yellow-400/10">
        <svg class="h-6 w-6 xl:h-8 xl:w-8 2xl:h-10 2xl:w-10 text-yellow-500 dark:text-yellow-400" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
      </div>
      <div class="flex-1">
        <h3 class="font-gotham text-xl font-semibold tracking-tight text-neutral-800 dark:text-neutral-200 sm:text-2xl xl:text-3xl 2xl:text-4xl">
          Actualización de Alquileres
        </h3>
        <p class="mt-1 font-nunito text-sm xl:text-base 2xl:text-lg text-neutral-600 dark:text-neutral-400">
          <strong class="text-yellow-500 dark:text-yellow-400">{date}</strong> — Índice de Contrato de Locación (ICL)
        </p>
      </div>
    </div>

    <!-- Content Grid -->
    <div class="grid gap-6 xl:gap-8 2xl:gap-10 md:grid-cols-2 lg:grid-cols-4">
      {items.map((item: UpdateItem) => (
        <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-4 xl:p-6 2xl:p-8 text-center dark:border-neutral-700 dark:bg-neutral-800">
          <div class="font-gotham text-2xl xl:text-3xl 2xl:text-4xl font-bold text-yellow-500 dark:text-yellow-400">
            {item.value}
          </div>
          <div class="mt-1 xl:mt-2 font-nunito text-sm xl:text-base 2xl:text-lg font-medium text-neutral-700 dark:text-neutral-300">
            {item.label}
          </div>
        </div>
      ))}
    </div>

    <!-- Footer -->
    <div class="mt-6 xl:mt-8 2xl:mt-10 border-t border-neutral-200 pt-4 xl:pt-6 2xl:pt-8 dark:border-neutral-700">
      <p class="font-nunito text-xs xl:text-sm 2xl:text-base text-neutral-500 dark:text-neutral-400">
        <strong>Fuente:</strong> Colegio de Martilleros y Corredores Públicos — Departamento Judicial La Plata
      </p>
    </div>
  </div>
</section>
