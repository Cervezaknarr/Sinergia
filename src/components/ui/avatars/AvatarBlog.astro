---
// Import necessary components
import { Image } from "astro:assets";

const { blogEntry } = Astro.props;

// NOTE: this component is currently unused (no callers in src/) and predates
// this project's use of Astro content collections, so its Props type is
// intentionally loose rather than backed by a real "blog" collection.
interface Props {
  blogEntry: any;
}
---

<div class="flex-shrink-0">
  <Image
    class="size-[46px] rounded-full border-2 border-neutral-50"
    src={blogEntry.data.authorImage}
    alt={blogEntry.data.authorImageAlt}
    draggable={"false"}
    format={"avif"}
  />
</div>
