---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSection from "@components/sections/landing/HeroSection.astro";
import HeroSectionAlt from "@components/sections/landing/HeroSectionAlt.astro";
import FeaturesNavs from "@components/sections/features/FeaturesNavs.astro";
import TestimonialsSection from "@components/sections/testimonials/TestimonialsSection.astro";
import PricingSection from "@components/sections/pricing/PricingSection.astro";
import FAQ from "@components/sections/FAQ.astro";
import heroImage from "@images/imagen_llaves.png";
import faqs from "@data/faqs.json";
import companiesAttached from "@data/companiesAttached.json";
import pricing from "@data/pricing.json";
import calculatingcosts from "@images/calculatingcosts.png";
import parejita from "@images/parejita.png";
import alquilerseguro from "@images/alquilerseguro.png";
import CompaniesAttached from "@/components/sections/CompaniesAttached.astro";
import DollarSection from "@/components/sections/landing/DollarSection.tsx";
import calcuEle from "@images/calcuEle.jpeg";
import familiaEle from "@images/familiaEle.jpeg";
import casaEle from "@images/casaEle.jpeg";
import { fade } from "astro:transitions";
import UpdateBanner from "@components/sections/UpdateBanner.astro";
import updates from "@data/updates.json";
---
<meta name="google-site-verification" content="Op6aoDLtTX-3du-rvTUIEHfc0I4vjVlcnWxIG0HvGYk" />
<MainLayout>
  <div class="flex flex-col gap-[12rem]">
    <HeroSection
      title=`<span
        class="dark:text-white text-neutral-700 font-gotham">Sinergia Valores S.A.</span>`
      subTitle="Sistema de fianzas de alquiler 100 % digital con calificacion en 24 hs."
      primaryBtn="Solicita tu Garantía"
      primaryBtnURL="/solicitud"
      secondaryBtn="Calcula costos"
      secondaryBtnURL="/calculadora"
      withReview={true}
      rating=`<span class="font-bold">4.8</span> / 5`
      starCount={4}
      reviews=`From Over <span class="font-bold">12.8k</span> Reviews`
      src={heroImage}
      alt=""
    />

    <!-- <DollarSection client:load /> -->

    <FeaturesNavs
      title=`<span class="text-yellow-400">Accede a tus sueños!</span>`
      tabs={[
        {
          heading: "Calcula Gratis",
          content: "Descubre el costo de tu garantía sin compromiso. Calcula ahora mismo de manera rápida y gratuita.",
          svg: "tools",
          src: calcuEle,
          alt: "Descubre el costo de tu garantía sin compromiso. Calcula ahora mismo de manera rápida y gratuita.",
          first: true,
        },
        {
          heading: "Solicita Tu Garantía",
          content: "Obtén tu garantía de manera fácil y rápida. Completa el formulario y recibe tu garantía al instante.",
          svg: "dashboard",
          src: familiaEle,
          alt: "Obtén tu garantía de manera fácil y rápida. Completa el formulario y recibe tu garantía al instante.",
          second: true,
        },
        {
          heading: "Alquila Seguro",
          content: "Protege tu inversión con nuestra garantía de alquiler. Alquila seguro y sin preocupaciones.",
          svg: "house",
          src: casaEle,
          alt: "Protege tu inversión con nuestra garantía de alquiler. Alquila seguro y sin preocupaciones.",
        },
      ]}
    />

    <TestimonialsSection
      title=""
      subTitle=""
      statistics={[
        {
          header: "CONFIANZA",
          description:
            "Equipo liderado por profesionales idoneos del area legal y financiero comprometidos con el servicio y respaldo durante todo el proceso.",
        },
        {
          header: "SEGURIDAD",
          description: "Protege tu inversion con nuestro sistema de garantías para alquiler basado en el analisis por scoring.",
        },
        {
          header: "SIMPLE, RAPIDO Y DIGITAL",
          description: "La conformidad de la garantía para alquiler es gestionada en 24 hs mediante un procedimiento 100 % digital.",
        },
        {
          header: "LIQUIDEZ INMEDIATA",
          description: "Ante impagos respondemos con liquidez inmediata hasta la restitucion de la propiedad.",
        },
      ]}
    />

    <UpdateBanner date={updates.date} items={updates.items} />

    <FAQ title="Preguntas Frecuentes" faqs={faqs} />

    <!-- <CompaniesAttached title={companiesAttached.title} inmobiliarias={companiesAttached.inmobiliarias} /> -->
  </div>
</MainLayout>
